<idea-plugin>
    <id>com.github.tropin.rider-mcp</id>
    <name>Rider MCP Extension</name>
    <vendor url="https://github.com/tropin">tropin</vendor>

    <description><![CDATA[
        Extends the JetBrains MCP Server plugin with IDE observability and control for Rider.
        Build management, process control, IDE state monitoring, editor context and bookmarks.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.mcpServer</depends>

    <extensions defaultExtensionNs="com.intellij.mcpServer">
        <!-- Build -->
        <mcpTool implementation="com.github.tropin.ridermcp.build.StartBuildTool"/>
        <mcpTool implementation="com.github.tropin.ridermcp.build.GetBuildOutputTool"/>
        <mcpTool implementation="com.github.tropin.ridermcp.build.CancelBuildTool"/>

        <!-- Process management -->
        <mcpTool implementation="com.github.tropin.ridermcp.process.ListProcessesTool"/>
        <mcpTool implementation="com.github.tropin.ridermcp.process.KillProcessTool"/>

        <!-- IDE state -->
        <mcpTool implementation="com.github.tropin.ridermcp.ide.GetIdeStateTool"/>
        <mcpTool implementation="com.github.tropin.ridermcp.ide.GetNotificationsTool"/>
        <mcpTool implementation="com.github.tropin.ridermcp.ide.ListToolWindowsTool"/>
        <mcpTool implementation="com.github.tropin.ridermcp.ide.GetToolWindowContentTool"/>

        <!-- Programmer context -->
        <mcpTool implementation="com.github.tropin.ridermcp.context.GetContextTool"/>
        <mcpTool implementation="com.github.tropin.ridermcp.context.GetRecentFilesTool"/>
    </extensions>
</idea-plugin>
